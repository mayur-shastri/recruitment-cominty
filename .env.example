# Copy to .env and fill in. Never commit .env.

# Supabase Postgres — direct connection string (port 5432)
DATABASE_URL=

# Slack (AcmeTech Recruiter app)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Cominty
COMINTY_API_KEY=
COMINTY_USER_ID=
COMINTY_RECRUITER_AGENT_ID=
COMINTY_ASSESSMENT_AGENT_ID=
COMINTY_DB_MCP_CONNECTION_ID=
COMINTY_SCHEDULER_AGENT_ID=

# Polling fallback for scoring (Harly webhooks broken upstream): sweep
# unscored applications on this interval. Set ENABLED=false to rely on
# webhooks alone.
ASSESSMENT_POLL_ENABLED=true
ASSESSMENT_POLL_INTERVAL_S=300

# Harly ATS (MCP server; required from M2.1a on)
# Base is scheme+host only — do NOT append /api/v1 (request paths carry it,
# matching the servers.url + paths split in harly-openapi.json).
HARLY_BASE_URL=https://example.com
HARLY_API_KEY=

# Harly webhook signing secrets (returned once at registration; receiver at
# <backend-base-url>/harly/events verifies deliveries against these)
HARLY_WEBHOOK_SECRET_APPLICATION_CREATED=
HARLY_WEBHOOK_SECRET_STAGE_CHANGED=

# Harly resume storage (Cloudflare R2, read-only token: List + Get for the
# join of Harly file records to S3 objects; fetches use the public URL)
HARLY_S3_ENDPOINT=
HARLY_S3_BUCKET=
HARLY_S3_REGION=auto
HARLY_S3_ACCESS_KEY_ID=
HARLY_S3_SECRET_ACCESS_KEY=
HARLY_S3_WORKSPACE_ID=
HARLY_S3_PUBLIC_URL=
